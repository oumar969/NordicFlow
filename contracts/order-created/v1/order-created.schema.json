{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nordicflow.io/orders/order-created/v1",
  "title": "OrderCreatedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "source", "tenantId", "data"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "nordicflow.order.created.v1"},
    "schemaVersion": {"const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1, "maxLength": 100},
    "tenantId": {"type": "string", "format": "uuid"},
    "correlationId": {"type": ["string", "null"], "format": "uuid"},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["orderId", "orderNumber", "customerId", "currency", "totalAmountMinor", "lines"],
      "properties": {
        "orderId": {"type": "string", "format": "uuid"},
        "orderNumber": {"type": "string", "minLength": 1, "maxLength": 50},
        "customerId": {"type": "string", "format": "uuid"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "totalAmountMinor": {"type": "integer", "minimum": 0},
        "requestedDeliveryDate": {"type": ["string", "null"], "format": "date"},
        "lines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["lineNumber", "sku", "quantity", "unitPriceMinor"],
            "properties": {
              "lineNumber": {"type": "integer", "minimum": 1},
              "sku": {"type": "string", "minLength": 1, "maxLength": 100},
              "quantity": {"type": "number", "exclusiveMinimum": 0},
              "unitPriceMinor": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}

